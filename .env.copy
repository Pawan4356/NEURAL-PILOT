## Hugging Face Inference Providers
## Replace this placeholder with a real token before starting a run.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_PROVIDER=auto

## Local web server
NEURALPILOT_HOST=127.0.0.1
NEURALPILOT_PORT=8000

## Orchestration limits
NEURALPILOT_MAX_ITERATIONS=5
NEURALPILOT_RUN_BUDGET_S=900
NEURALPILOT_SEED=42

## Compute budgets
NEURALPILOT_HPO_MAX_TRIALS=50
NEURALPILOT_HPO_TIMEOUT_S=300
NEURALPILOT_HPO_MAX_ROWS=50000

## Input limits
NEURALPILOT_MAX_ROWS=2000000
NEURALPILOT_MAX_COLS=500

## Leakage handling: "drop" excludes flagged columns, "warn" only reports them
NEURALPILOT_LEAKAGE_ACTION=drop
