## Hugging Face Inference Providers
## Replace this placeholder with a real token before starting a run.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_PROVIDER=auto

## LLM source: "huggingface" (default) or "claude" (Anthropic API)
NEURALPILOT_LLM_SOURCE=huggingface
## Anthropic API key and model, used only when NEURALPILOT_LLM_SOURCE=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

## LLM transport: "langchain" (default) or "hf" (the original client, rollback only)
NEURALPILOT_LLM_BACKEND=langchain
## Provider structured output: "auto" tries it and falls back to JSON repair; "on" | "off"
NEURALPILOT_LLM_STRUCTURED_OUTPUT=auto
## How structure is requested: "function_calling" or "json_schema"
NEURALPILOT_LLM_STRUCTURED_METHOD=function_calling

## LangSmith tracing (optional). Payloads are redacted before they are sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neuralpilot-dev

## Local web server
NEURALPILOT_HOST=127.0.0.1
NEURALPILOT_PORT=8000

## Orchestration limits
NEURALPILOT_MAX_ITERATIONS=5
NEURALPILOT_RUN_BUDGET_S=900
NEURALPILOT_SEED=42

## Compute budgets
NEURALPILOT_HPO_MAX_TRIALS=50
NEURALPILOT_HPO_TIMEOUT_S=300
NEURALPILOT_HPO_MAX_ROWS=50000

## Input limits
NEURALPILOT_MAX_ROWS=2000000
NEURALPILOT_MAX_COLS=500

## Leakage handling: "drop" excludes flagged columns, "warn" only reports them
NEURALPILOT_LEAKAGE_ACTION=drop

## Candidates per iteration: the planner's plan plus up to N-1 deterministic challengers
NEURALPILOT_MAX_CANDIDATES=3

## Experiment tracking (MLflow). "off" keeps only SQLite and LangSmith.
## Inspect runs with: mlflow ui --backend-store-uri sqlite:///runs/mlflow.db
NEURALPILOT_MLFLOW=on
MLFLOW_TRACKING_URI=sqlite:///runs/mlflow.db
NEURALPILOT_MLFLOW_ARTIFACTS=runs/mlartifacts
